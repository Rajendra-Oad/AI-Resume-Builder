# Non-secret Compose settings. Copy to docker/.env on EC2.
# The staged certificate and key must be readable by container UID/GID 101.
NGINX_TLS_CERTIFICATE=/opt/ai-resume-builder/tls/fullchain.pem
NGINX_TLS_PRIVATE_KEY=/opt/ai-resume-builder/tls/privkey.pem

# Application secrets and settings belong only in backend/.env.
# Do not duplicate DB_PASSWORD, JWT_SECRET, or provider keys in this file.
