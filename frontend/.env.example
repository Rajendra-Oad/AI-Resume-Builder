# Leave unset for the recommended same-origin /api proxy. This keeps the
# HttpOnly refresh cookie working across reloads on localhost and LAN devices.
# VITE_API_BASE_URL=

# Vite's server-side proxy target (the browser never sees this address).
VITE_DEV_PROXY_TARGET=http://localhost:8080
## Optional: checks HIBP via k-anonymity; the password is never sent.
VITE_PASSWORD_BREACH_CHECK=false
