# Leave empty when Vercel proxies /api to Render through vercel.json.
VITE_API_BASE_URL=

# Optional privacy-preserving password breach check in the browser.
VITE_PASSWORD_BREACH_CHECK=false

# Optional browser error/performance monitoring. The DSN is public by design;
# never place a Sentry auth token or backend secret in a VITE_* variable.
VITE_SENTRY_DSN=
VITE_APP_ENV=production
VITE_APP_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
