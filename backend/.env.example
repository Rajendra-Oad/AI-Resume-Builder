# ============================================================================
# AI Resume Builder — Backend environment variables
# ============================================================================
# Copy this file to backend/.env for local development:
#   cp backend/.env.example backend/.env
# The backend loads backend/.env automatically on startup
# (spring.config.import=optional:file:./.env[.properties]).
#
# Values beginning with "replace-with-..." are placeholders: the application
# refuses to start while any required variable still contains one. Fill every
# placeholder before running.
#
# Requirements by environment:
#   DEV   — required for local development
#   TEST  — required for automated tests (see IT_DB_* in .github/workflows/ci.yml)
#   PROD  — required for the production deployment (Render)
#   opt   — optional; validated only when set or when the listed feature is on
#
# The authoritative production runbook is docs/Deployment.md; render.yaml and
# the GitHub Actions workflows are the machine-readable deployment definitions.

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Local development and the Docker Compose production stack use the single
# DB_URL form below. Render instead injects the decomposed form
# DB_HOST + DB_PORT + DB_NAME + DB_USERNAME + DB_PASSWORD + DB_SSL_MODE and
# the production profile composes the JDBC URL from those. Either form is
# accepted; DB_PASSWORD and (in production) DB_USERNAME are always required.
#
DB_URL=jdbc:postgresql://localhost:5432/ai_resume_builder   # DEV, TEST — full JDBC URL
# DB_HOST=localhost                                         # PROD (Render) — when DB_URL is not set
# DB_NAME=ai_resume_builder                                 # PROD (Render) — when DB_URL is not set
# DB_PORT=5432                                              # opt — default 5432
# DB_SSL_MODE=require                                       # PROD — default require
DB_USERNAME=postgres                                        # DEV, TEST, PROD
DB_PASSWORD=replace-with-your-postgres-password             # DEV, TEST, PROD — required in every profile

# Optional Hikari pool overrides (production profile only)
# DB_POOL_MAX_SIZE=10
# DB_POOL_MIN_IDLE=2
# DB_CONNECTION_TIMEOUT_MS=30000
# DB_VALIDATION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=600000
# DB_MAX_LIFETIME_MS=1800000

# ----------------------------------------------------------------------------
# Security / JWT
# ----------------------------------------------------------------------------
# Random secret of at least 32 characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=replace-with-at-least-32-random-characters       # DEV, TEST, PROD — required in every profile
# JWT_ACCESS_TOKEN_TTL=PT15M                                # opt — ISO-8601 duration
# JWT_ISSUER=ai-resume-builder                              # opt
# JWT_AUDIENCE=ai-resume-builder-web                        # opt
# REFRESH_TOKEN_TTL=P30D                                    # opt — ISO-8601 duration

# ----------------------------------------------------------------------------
# Frontend / CORS / cookies
# ----------------------------------------------------------------------------
APP_FRONTEND_URL=http://localhost:5173                      # DEV; PROD — must be the public HTTPS frontend URL
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173  # DEV; PROD — comma-separated HTTPS origins
APP_SECURE_COOKIES=false                                    # DEV — false; PROD — must be "true"

# ----------------------------------------------------------------------------
# AI provider (one active provider at a time)
# ----------------------------------------------------------------------------
AI_PROVIDER=gemini                                          # DEV, PROD — "gemini" or "openai"
GEMINI_API_KEY=replace-with-your-gemini-api-key             # PROD (required when AI_PROVIDER=gemini); opt in DEV
# OPENAI_API_KEY=replace-with-your-openai-api-key           # PROD (required when AI_PROVIDER=openai); opt in DEV
# GEMINI_MODEL=gemini-3.5-flash                             # opt
# OPENAI_MODEL=gpt-5-mini                                   # opt

# AI rate limit, budget and cache (validated when set)
# AI_RATE_LIMIT_PER_USER_PER_HOUR=20
# AI_BUDGET_PER_USER_MONTHLY_USD=2.00
# AI_CACHE_TTL_SECONDS=900

# User-provided (BYOK) credential encryption — Base64 encoding of exactly 32
# random bytes (e.g. `openssl rand -base64 32`). PROD — required.
USER_API_KEY_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes   # PROD; opt in DEV

# Optional Redis-backed distributed rate limiting. Only set these when you
# have provisioned Redis; enabling without a server breaks startup.
# AI_REDIS_ENABLED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ----------------------------------------------------------------------------
# Metrics (Prometheus)
# ----------------------------------------------------------------------------
# Random token protecting /actuator/prometheus
# (e.g. `openssl rand -base64 48`). PROD — required.
MANAGEMENT_METRICS_TOKEN=replace-with-random-metrics-token  # PROD; opt in DEV

# ----------------------------------------------------------------------------
# Email (verification and recovery)
# ----------------------------------------------------------------------------
# SMTP is all-or-nothing: if any of the three is set, all three are required.
# PROD — all three required for account verification/recovery.
SPRING_MAIL_HOST=smtp.gmail.com                             # PROD; opt in DEV
# SPRING_MAIL_PORT=587                                      # opt — default 587
SPRING_MAIL_USERNAME=replace-with-smtp-username             # PROD; opt in DEV
SPRING_MAIL_PASSWORD=replace-with-smtp-password             # PROD; opt in DEV
# MAIL_FROM=AI Resume Builder <no-reply@example.com>        # opt — sender identity

# ----------------------------------------------------------------------------
# Development seed data (backend run via scripts/seed-dev.sh)
# ----------------------------------------------------------------------------
# DEV_SEED_ENABLED=true requires SPRING_PROFILES_ACTIVE=dev and a password of
# at least 12 characters. Leave both unset/off for normal development.
# DEV_SEED_ENABLED=false
# DEV_SEED_PASSWORD=replace-with-at-least-12-characters

# ----------------------------------------------------------------------------
# Server / upload (optional overrides)
# ----------------------------------------------------------------------------
# Render injects PORT; Spring binds through server.port=${PORT:8080}.
# PORT=8080
# MAX_UPLOAD_FILE_SIZE=5MB
# MAX_UPLOAD_REQUEST_SIZE=6MB
# HTTP_CONNECT_TIMEOUT=PT5S
# HTTP_READ_TIMEOUT=PT10S
