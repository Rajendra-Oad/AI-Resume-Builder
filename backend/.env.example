DB_URL=jdbc:mysql://localhost:3306/ai_resume_builder
DB_USERNAME=root
DB_PASSWORD=Rajendra@2026
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_ISSUER=ai-resume-builder
JWT_AUDIENCE=ai-resume-builder-web
APP_FRONTEND_URL=http://localhost:5173
# Set true only behind HTTPS in production.
APP_SECURE_COOKIES=false
MAIL_FROM=AI Resume Builder <no-reply@example.com>
# Configure SMTP to deliver verification/recovery messages; do not commit credentials.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Base64-encoded 32-byte AES key used only to encrypt user-provided provider keys.
USER_API_KEY_ENCRYPTION_KEY=
AI_PROVIDER=gemini
# Include the Vite URL used on this computer or LAN, for example http://192.168.1.50:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phone verification. Local development: fake. Production: msg91.
OTP_PROVIDER=fake
OTP_TTL=PT5M
OTP_RESEND_COOLDOWN=PT1M
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_BASE_URL=https://control.msg91.com
# Development-only Android/Jio SIM gateway alternative:
ANDROID_SMS_GATEWAY_URL=http://192.168.1.46:8080/send-sms
ANDROID_SMS_GATEWAY_API_KEY=
# TextBee Android gateway (recommended for real SMS during development):
TEXTBEE_BASE_URL=https://api.textbee.dev
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=6a5f30ebceb4314c6c22ced5
TEXTBEE_SIM_SUBSCRIPTION_ID=6
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-5-mini

# Development-only deterministic demo data. Requires SPRING_PROFILES_ACTIVE=dev.
DEV_SEED_ENABLED=false
DEV_SEED_PASSWORD=replace-with-at-least-12-characters
