DB_URL=jdbc:mysql://localhost:3306/ai_resume_builder
DB_USERNAME=root
DB_PASSWORD=replace-with-local-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_ISSUER=ai-resume-builder
JWT_AUDIENCE=ai-resume-builder-web
APP_FRONTEND_URL=http://localhost:5173
# Set true only behind HTTPS in production.
APP_SECURE_COOKIES=false
MAIL_FROM=AI Resume Builder <no-reply@example.com>
# Configure SMTP to deliver verification/recovery messages; do not commit credentials.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Base64-encoded 32-byte AES key used only to encrypt user-provided provider keys.
USER_API_KEY_ENCRYPTION_KEY=
AI_PROVIDER=gemini
# Include the Vite URL used on this computer or LAN, for example http://192.168.1.50:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-5-mini

# Development-only deterministic demo data. Requires SPRING_PROFILES_ACTIVE=dev.
DEV_SEED_ENABLED=false
DEV_SEED_PASSWORD=replace-with-at-least-12-characters
